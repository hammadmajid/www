---
import ProjectCard from "./project-card.astro";
import type { Tech } from "@/types/tech";
import { TypographyH2, TypographyMuted } from "./typography";

interface Project {
    title: string;
    description: string;
    techStack: Tech[];
    livePreviewUrl?: string;
    githubUrl?: string;
}

const projects: Project[] = [
    {
        title: "Zabdoc",
        description: "Utility tools for Szabist students.",
        techStack: [
            "Svelte",
            "Go",
            "Workers",
            "Docker",
            "shadcn/ui",
            "Tailwind",
            "TypeScript",
        ],
        livePreviewUrl: "https://zabdoc.xyz",
        githubUrl: "https://github.com/hammadmajid/zabdoc",
    },
    {
        title: "Studio Pret",
        description: "E-commerce store running on Cloudflare Workers.",
        techStack: [
            "Svelte",
            "SQLite",
            "Workers",
            "Drizzle",
            "shadcn/ui",
            "Zod",
            "Resend",
            "Tailwind",
            "TypeScript",
        ],
        livePreviewUrl: "https://studio-pret.com",
    },
    {
        title: "Silroad",
        description: "Event management for the organization.",
        techStack: [
            "Svelte",
            "Skeleton",
            "Workers",
            "SQLite",
            "Drizzle",
            "Inbound",
            "Tailwind",
            "TypeScript",
            "Zod",
        ],
        livePreviewUrl: "https://silroad.space",
        githubUrl: "https://github.com/hammadmajid/silroad",
    },

];
---

<section id="projects">
    <div class="mb-6 fade-in">
        <TypographyH2>Projects</TypographyH2>
        <TypographyMuted class="text-muted-foreground mb-6">
            Here are some of the projects I've worked on recently.
        </TypographyMuted>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
            projects.map((project, index) => (
                <div class={`fade-in-delayed ${index % 2 === 0 ? 'fade-in-left' : 'fade-in-right'}`}>
                    <ProjectCard
                        title={project.title}
                        description={project.description}
                        techStack={project.techStack}
                        livePreviewUrl={project.livePreviewUrl}
                        githubUrl={project.githubUrl}
                    />
                </div>
            ))
        }
    </div>
</section>
